# --- Development ---------------------------------------------------------
# In dev, leave VITE_API_BASE_URL empty so requests stay relative (/api/v1/...)
# and flow through the Vite dev proxy below — no CORS setup needed.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api and /media to.
# The backend has its own subdomain (no path prefix): /api/v1/... -> <target>/api/v1/...
VITE_API_PROXY_TARGET=https://chatbot-api.zaychain.com

# --- Production ----------------------------------------------------------
# Prefer the Vercel rewrite (vercel.json) so requests stay same-origin. Only set
# this to call the API directly — the backend must then whitelist your frontend
# origin in CORS_ALLOWED_ORIGINS.
#   VITE_API_BASE_URL=https://chatbot-api.zaychain.com
