{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path(api/.*)",
      "destination": "https://chatbot-api.zaychain.com/:path"
    },
    {
      "source": "/:path(media/.*)",
      "destination": "https://chatbot-api.zaychain.com/:path"
    },
    { "source": "/((?!api/|media/).*)", "destination": "/index.html" }
  ]
}
